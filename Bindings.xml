<Bindings>
	<!-- WeintCodex: Tastenbelegung (6.84.4.0). Erscheint im Spiel unter
	     Tastenbelegung -> AddOns -> WeintCodex. Nur ungeschuetzter Code. -->
	<Binding name="WEINTCODEX_FARM_SKIP" header="WEINTCODEX" category="ADDONS">
		if WeintCodex and WeintCodex.UIGatherAtlas then WeintCodex.UIGatherAtlas.Skip() end
	</Binding>
	<!-- 6.87.5.0: direkt neu laden - klickt den gesicherten Knopf. -->
	<Binding name="CLICK WeintCodexReloadDirect:LeftButton" header="WEINTCODEX" category="ADDONS"/>
</Bindings>
