{"nodes": [{"id": "media_logo_weintcodex_logo", "label": "WeintCodex Logo (Banner Artwork)", "file_type": "image", "source_file": "media/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "media_logo_wordmark_weintcodex", "label": "Wordmark \"WeintCodex\" (green/purple split)", "file_type": "concept", "source_file": "media/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "media_logo_tagline_raid_guide_intelligence_system", "label": "Tagline: RAID GUIDE & INTELLIGENCE SYSTEM", "file_type": "concept", "source_file": "media/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "media_logo_alliance_lion_crest", "label": "Alliance Lion Crest Emblem", "file_type": "concept", "source_file": "media/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "media_logo_codex_props_tome_scroll_lantern", "label": "Codex Props: Tome, Scroll, Lantern, Quill", "file_type": "concept", "source_file": "media/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "media_logo_purple_gold_accent_palette", "label": "Purple/Gold/Green Accent Palette", "file_type": "rationale", "source_file": "media/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The artwork carries exactly one saturated accent hue (purple/violet, identical to the addon's accent/purple/violet/brandA token) plus gold framing and a green gem highlight. A single meaning-bearing accent in the brand mark matches the repository rule that accent, purple, violet and brandA are deliberately the same colour, so the logo cannot introduce a second competing signal colour into the UI."}, {"id": "media_logo_ornate_frame_banner", "label": "Ornate Gold Banner Frame with Gem Finials", "file_type": "concept", "source_file": "media/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "media_logo_transparent_wide_banner_format", "label": "Wide Transparent PNG Banner Format", "file_type": "rationale", "source_file": "media/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roughly 3:1 landscape with an alpha background and soft purple bloom bleeding past the frame, so it composites onto the addon's dark panel background without a visible box. A fixed-size raster banner implies the header surface that draws it must reserve a stable width/height rather than scaling text, and the media path is referenced absolutely from core/ui.lua because the addon folder name is fixed."}, {"id": "media_logo_brand_identity_weint_ecosystem", "label": "Weint Brand Identity (shared across Codex, Companion, Bot)", "file_type": "rationale", "source_file": "media/logo.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The mark names the product, not the edition: nothing in the artwork says \"Forever\", \"Mists of Pandaria\" or a version. The same banner can therefore serve the in-game addon and the Companion desktop app whose theme tokens core/ui.lua translates, and it survives an edition change without a redraw."}], "edges": [{"source": "media_logo_weintcodex_logo", "target": "media_logo_wordmark_weintcodex", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_logo_weintcodex_logo", "target": "media_logo_tagline_raid_guide_intelligence_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_logo_weintcodex_logo", "target": "media_logo_alliance_lion_crest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_logo_weintcodex_logo", "target": "media_logo_codex_props_tome_scroll_lantern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_logo_weintcodex_logo", "target": "media_logo_ornate_frame_banner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_logo_purple_gold_accent_palette", "target": "media_logo_weintcodex_logo", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_logo_transparent_wide_banner_format", "target": "media_logo_weintcodex_logo", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_logo_brand_identity_weint_ecosystem", "target": "media_logo_weintcodex_logo", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_logo_wordmark_weintcodex", "target": "media_logo_purple_gold_accent_palette", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_logo_ornate_frame_banner", "target": "media_logo_purple_gold_accent_palette", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "media/logo.png", "source_location": null, "weight": 1.0}, {"source": "media_log