{"nodes": [{"id": "docs_architecture_overview_graphit", "label": "Designsprache \u201eGraphit\"", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## Das Bild", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dieselbe Sprache wie WeintCompanion 5, damit wer zwischen Spiel und Desktop wechselt nicht zwei Programme sieht."}, {"id": "docs_architecture_overview_depth_by_layering", "label": "Tiefe durch Schichtung, nicht durch Rahmen", "file_type": "rationale", "source_file": "docs/architecture/overview.md", "source_location": "## Das Bild", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eine Karte hat keinen umlaufenden Rahmen, sondern senkrechten Verlauf und 1-px-Oberkante; die Staffelung ist sunken < base < card < raised."}, {"id": "docs_architecture_overview_three_fonts", "label": "Drei Schriften, drei Aufgaben", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## Das Bild", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Newsreader (Serife) f\u00fcr \u00dcberschriften, IBM Plex Sans f\u00fcr alles Bedienbare, IBM Plex Mono f\u00fcr Zahlen und Rubriken."}, {"id": "docs_architecture_overview_cutcorners", "label": "CutCorners (Eckmasken statt border-radius)", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## Drei Dinge, die in WoW anders gel\u00f6st werden m\u00fcssen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frames k\u00f6nnen keinen Radius haben; vier Viertelkreis-Masken in der Farbe dahinter stanzen die Ecken aus \u2014 deshalb muss jede Fl\u00e4che ein backdrop kennen."}, {"id": "docs_architecture_overview_applyverticalgradient", "label": "ApplyVerticalGradient", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## Drei Dinge, die in WoW anders gel\u00f6st werden m\u00fcssen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SetGradient(\"VERTICAL\", min, max) l\u00e4uft von unten nach oben; die beiden Farben werden deshalb vertauscht \u00fcbergeben."}, {"id": "docs_architecture_overview_spaced", "label": "Spaced (Sperrung durch Haarspatien)", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## Drei Dinge, die in WoW anders gel\u00f6st werden m\u00fcssen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "letter-spacing gibt es in WoW nicht; gesperrt wird je Zeichen, nicht je Byte."}, {"id": "docs_architecture_overview_utf8_helpers", "label": "UTF-8-Helfer (Upper/Utf8Len/Utf8Sub/Truncate)", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## UTF-8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lua 5.1 kennt nur Bytes; ein zerschnittener Umlaut wird im Spiel zu leeren K\u00e4stchen \u2014 in der Vorg\u00e4ngerfassung wurde aus \u201e\u00dcBERSICHT\" ein \u201e<>BERSICHT\"."}, {"id": "docs_architecture_overview_formatgrouped", "label": "FormatGrouped", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## UTF-8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "string.reverse dreht Bytes; ein direkt eingef\u00fcgtes schmales Leerzeichen k\u00e4me als ung\u00fcltige UTF-8-Folge wieder heraus."}, {"id": "docs_architecture_overview_window_layout", "label": "Fensteraufbau (Titelleiste, Navigation 232, ContentPanel, Detailbereich 372)", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## Der Fensteraufbau", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module zeichnen ausschliesslich in WeintCodex.ContentPanel und rechnen gegen dessen Gr\u00f6sse \u2014 ob rechts ein Detailbereich oder links eine Unternavigation steht, \u00e4ndert nur diese Gr\u00f6sse."}, {"id": "docs_architecture_overview_core_ui", "label": "core/ui.lua (Fl\u00e4chen und Bausteine)", "file_type": "code", "source_file": "docs/architecture/overview.md", "source_location": "## Der Fensteraufbau", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_overview_core_navigation", "label": "core/navigation.lua (Spalte, SwitchTo, ShowHome, SetInspector)", "file_type": "code", "source_file": "docs/architecture/overview.md", "source_location": "## Der Fensteraufbau", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_overview_artwork", "label": "WeintCodex.Artwork (Bild und Schleier)", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "### Bilder", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der einzige Baustein, der ein Bild zeichnet \u2014 Bild und Schleier geh\u00f6ren zusammen, weil ein Bild ohne Schleier den Text darauf unlesbar macht. art = nil zeichnet nichts und gibt nil zur\u00fcck: der R\u00fcckfall, auf den sich jede Seite ohne Fallunterscheidung verl\u00e4sst."}, {"id": "docs_architecture_overview_covercoords", "label": "WeintCodex.CoverCoords", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "### Bilder", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rechnet den f\u00fcllenden Ausschnitt ohne zu verzerren: die k\u00fcrzere Seite wird um focusX/focusY herum beschnitten \u2014 ein in anderen Formaten gespanntes Bild staucht Gesichter."}, {"id": "docs_architecture_overview_data_artwork", "label": "data/artwork.lua (die einzige Stelle mit Bildpfaden)", "file_type": "code", "source_file": "docs/architecture/overview.md", "source_location": "### Bilder", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "data_test.lua pr\u00fcft jede Zeile gegen media/: ein Pfad ohne Datei zeichnet im Spiel ein gr\u00fcnes Rechteck, und das sieht aus wie ein Bild."}, {"id": "docs_architecture_overview_setinspector", "label": "Navigation.SetInspector (Detailbereich)", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "### Der Detailbereich", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Er tr\u00e4gt Tatsachen und Begr\u00fcndungen, keine Bedienung \u2014 was man umstellen kann, steht dort, wo man es sieht. Er erscheint nur, wenn es etwas zu zeigen gibt."}, {"id": "docs_architecture_overview_buildsidebar", "label": "BuildSidebar (Unternavigation)", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "### Die Unternavigation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bis sieben reine Beschriftungen wird es eine Reiterleiste, dar\u00fcber eine Listenspalte. indent = true beantwortet 'wo bin ich' auf zwei Ebenen gleichzeitig statt nacheinander in einer Brotkrume."}, {"id": "docs_architecture_overview_status_field", "label": "status: Text oder { text, color }", "file_type": "rationale", "source_file": "docs/architecture/overview.md", "source_location": "### Die Unternavigation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bis 5.1.0.0 nahm status nur die Tabellenform; die Schlachtzugseite \u00fcbergab einen nackten String, (\"10er\").text ist nil \u2014 die Zeile wurde 44 px hoch gebaut und blieb leer. Kein Fehler, keine Meldung, nur eine Auskunft, die nie ankam."}, {"id": "docs_architecture_overview_second_line_not_spaced", "label": "Zweite Zeile ist ein Wert, keine Rubrik", "file_type": "rationale", "source_file": "docs/architecture/overview.md", "source_location": "### Die Unternavigation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gesperrte Versalien sind in dieser Oberfl\u00e4che die Form einer Rubrik. \u201eS T U F E  1 3 \u2013 1 8\" liest sich als Muster, ist doppelt so breit wie n\u00f6tig und lief rechts aus der Spalte \u2014 derselbe Fehler, den 5.2.0.2 am Gruppenkopf behob."}, {"id": "docs_architecture_overview_mark_costs_width", "label": "mark kostet der Beschriftung Breite", "file_type": "rationale", "source_file": "docs/architecture/overview.md", "source_location": "### Die Unternavigation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein gesperrtes FOREVER nahm rund 70 der 176 px und schnitt jeden Namen ab, der l\u00e4nger war als \u201eHall of Thanes\"."}, {"id": "docs_architecture_overview_subnav_group_spacing", "label": "SUBNAV_GROUP_TOP / SUBNAV_GROUP_BOT", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "### Die Unternavigation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Zwischentitel geh\u00f6rt zu dem, was unter ihm steht (12 oben, 2 unten). MeasureSidebar rechnet mit denselben Konstanten \u2014 st\u00fcnden die Zahlen an zwei Stellen, liefe eine nach und die Spalte liefe still \u00fcber."}, {"id": "docs_architecture_overview_measuresidebar", "label": "MeasureSidebar / NavColumnHeight / SubNavHeight / Budgets", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "### Nichts muss scrollen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bis 5.1.0.0 stand die Rechnung nur als Kommentar (\u201ewer hier etwas erg\u00e4nzt, rechnet nach\") \u2014 ein Kommentar pr\u00fcft nichts. Der Pr\u00fcflauf verlangt zus\u00e4tzlich Luft f\u00fcr einen weiteren Eintrag, sonst lautet die Frage nicht mehr 'passt er?', sondern 'was werfen wir raus?'."}, {"id": "docs_architecture_overview_paragraph", "label": "WeintCodex.Paragraph / EstimateLines (gesch\u00e4tzte Texth\u00f6hen)", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "### Nichts muss scrollen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Texth\u00f6hen werden aus Zeichen je Zeile gesch\u00e4tzt (0,60 em je Zeichen), nicht vom Client gemessen \u2014 die Attrappe misst jede Zeile mit 12 px, eine Seite, die damit rechnete, w\u00e4re im Pr\u00fcflauf k\u00fcrzer als im Spiel."}, {"id": "docs_architecture_overview_pagehead", "label": "WeintCodex.PageHead", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## Der Seitenkopf", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der einzige Ort, an dem ein Seitenkopf entsteht \u2014 vorher baute ihn jede Seite selbst und drei Titelformen standen nebeneinander. Die Bausteine h\u00e4ngen aneinander statt an gerechneten Y-Werten, weil eine Ankerkette keine gesch\u00e4tzten Schriftmetriken braucht."}, {"id": "docs_architecture_overview_colortext", "label": "WeintCodex.Colors / ColorText", "file_type": "concept", "source_file": "docs/architecture/overview.md", "source_location": "## Farben ansprechen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Name, den es nicht gibt, f\u00e4rbt still auf Normaltext zur\u00fcck \u2014 genau die Sorte Fehler, die man erst im Spiel sieht. Deshalb bleiben alte Namen in core/ui.lua bestehen und zeigen auf die neuen Werte."}], "edges": [{"source": "claude_nothing_must_scroll", "target": "docs_systems_dungeons_page_budget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/overview.md", "source_location": "### Nichts muss scrollen", "weight": 1.0}, {"source": "claude_offline_t